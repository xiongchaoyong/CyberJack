CYBERJACK_USER_NAME=YourName
CYBERJACK_USER_GENDER=male
CYBERJACK_STATE_DIR=/absolute/path/to/cyberJack/.cyberJack-state
CYBERJACK_WORKSPACE_ROOT=/absolute/path/to/cyberJack
CYBERJACK_WEIXIN_ADAPTER=v2
CYBERJACK_RUNTIME=deepseek
CYBERJACK_DEEPSEEK_API_KEY=your_deepseek_api_key
CYBERJACK_DEEPSEEK_MODEL=deepseek-v4-flash
CYBERJACK_ALLOWED_USER_IDS=your_wechat_user_id
CYBERJACK_WECHAT_SKILL_PATH=/absolute/path/to/cyberJack/skills/jack-digital-avatar
CYBERJACK_DISABLE_DEFAULT_INSTRUCTIONS=true
CYBERJACK_WEIXIN_INSTRUCTIONS_FILE=-
CYBERJACK_WEIXIN_OPERATIONS_FILE=-
